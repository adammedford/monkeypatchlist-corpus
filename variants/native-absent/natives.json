     {
      "target": "Window.CSSGroupingRule",
      "guard": "if (canMonkeyPatchNestedCSSRule(\"CSSGroupingRule\")) … else { CSSMediaRule, CSSConditionRule, CSSSupportsRule }",
      "source": "@sentry/replay@10.75.3 build/npm/esm/index.js L3094",
      "writes": [
